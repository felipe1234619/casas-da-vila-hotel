  ],  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.casasdavila.com"
        }
      ],
      "destination": "https://casasdavila.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "es.casasdavila.com"
        }
      ],
      "destination": "https://casasdavila.com/pt/",
      "permanent": true
    },
{
  "source": "/",
  "has": [
    {
      "type": "header",
      "key": "x-vercel-ip-country",
      "value": "BR|PT"
    }
  ],
  "destination": "/pt/",
  "permanent": false
},
{
  "source": "/",
  "destination": "/en/",
  "permanent": false
},
    {
      "source": "/:path*",
