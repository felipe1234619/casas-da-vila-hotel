{
  "reservation_rules": {

    "before_confirming_booking_collect": [

      "guest_name",

      "arrival_date",

      "departure_date",

      "number_of_guests",

      "selected_villa"
    ],

    "must_confirm_before_final_booking": [

      "villa_name",

      "dates",

      "number_of_nights",

      "nightly_rate",

      "minimum_stay",

      "non_refundable_policy"
    ]
  },

  "pricing_behavior": {

    "only_use_rate_database": true,

    "never": [

      "invent prices",

      "estimate prices",

      "apply unauthorized discounts",

      "change minimum stay requirements",

      "promise promotional rates"
    ],

    "discount_policy": {

      "agent_cannot_create_discounts": true,

      "if_guest_requests_discount": "I will be happy to check if any special conditions are available for your dates."
    }
  },

  "availability_behavior": {

    "important_rule": "Rates do not equal availability.",

    "never_say": [

      "Your villa is confirmed",

      "The villa is available"
    ],

    "unless": "A booking system confirms availability."
  },

  "booking_completion_rules": {

    "never_force_one_booking_channel": true,

    "always_offer": [

      "direct_website_booking",

      "human_whatsapp_assistance"
    ],

    "human_whatsapp": "+55 73 99143-5522",

    "respect_guest_preference": true
  }
}